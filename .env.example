# PostgreSQL
POSTGRES_USER=interscribe
POSTGRES_PASSWORD=changeme
POSTGRES_DB=interscribe
DATABASE_URL=postgresql://interscribe:changeme@postgres:5432/interscribe

# Storage — host path mapped into containers via Docker volume
UPLOAD_STORAGE_PATH=/data/uploads

# WhisperX transcription
WHISPER_DEVICE=cuda           # cuda or cpu
WHISPER_MODEL_SIZE=large-v2   # tiny | base | small | medium | large-v2 | large-v3
WHISPER_COMPUTE_TYPE=float16  # float16 (GPU) | int8 (CPU)
WHISPER_BATCH_SIZE=16
WHISPER_MODEL_CACHE=/models/whisper

# HuggingFace — pyannote models are baked into the Docker image at build time.
# HF_TOKEN is only needed during `docker compose build` (passed via setup.sh, never stored here).
# HF_HUB_OFFLINE=1 prevents runtime network calls to HuggingFace.
HF_HOME=/models/hf
HF_HUB_OFFLINE=1

# Upload limits
MAX_UPLOAD_SIZE_BYTES=2147483648   # 2 GB
MAX_UPLOAD_DURATION_SECONDS=10800  # 3 hours

# Ollama / Phase 1 narrative extraction
OLLAMA_BASE_URL=http://ollama:11434
QWEN_MODEL=qwen3.5:9b

# Phase 2 — quote extraction (SPEC-003)
PHASE2_OVERLAP_TURNS=2          # whole-turn overlap between adjacent Phase 2 chunks
PHASE2_DEDUP_OVERLAP_RATIO=0.5  # segment range overlap ratio threshold for dedup merge
PHASE2_DEDUP_TEXT_SIMILARITY=0.85  # SequenceMatcher ratio threshold for dedup merge

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8002
